# Copy to .env and fill in real values. Do not commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=hoteldb
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Frontend origins allowed to call the API (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# AI travel assistant (Claude). Leave the key empty to use the basic rule-based search.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Chat requests allowed per client (the AI endpoint costs money per call)
AI_RATE_ANON=10/min
AI_RATE_USER=30/min

# Public base URL of this API, used for uploaded photo links outside a request
BACKEND_PUBLIC_URL=http://localhost:8001
